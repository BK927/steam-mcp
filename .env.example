# Copy to .env (or set in your MCP client config) and fill in your key.
# Get a free Steam Web API key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional: your own Steam name (vanity name, SteamID64, or profile URL). When
# set, the "about me" tools default to you when you don't name a user. Not a
# secret — it's a public profile name.
STEAM_USER=

# Local clients use stdio. Cloud Run and remote plugins use Streamable HTTP.
MCP_TRANSPORT=stdio
HOST=0.0.0.0
PORT=8080
MCP_PATH=/mcp
HEALTH_PATH=/healthz
HTTP_MAX_BODY_BYTES=2097152

# Required in HTTP mode unless MCP_ALLOW_UNAUTHENTICATED=true.
MCP_ACCESS_TOKEN=
MCP_ALLOW_UNAUTHENTICATED=false

# Set to the Cloud Run base URL after the first deployment.
PUBLIC_BASE_URL=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Compact result/cursor controls. CURSOR_SECRET falls back to MCP_ACCESS_TOKEN.
STEAM_CURSOR_SECRET=
STEAM_CURSOR_TTL_SECONDS=86400
STEAM_MAX_RESULT_BYTES=12288

# Local mode defaults. Cloud Run MCP sets these to gcp/mcp; the private worker
# uses the same image with STEAM_PROCESS_ROLE=worker.
STEAM_JOB_BACKEND=memory
STEAM_PROCESS_ROLE=mcp
GCP_PROJECT=
GCP_LOCATION=asia-northeast1
STEAM_JOB_QUEUE=steam-mcp-jobs
STEAM_JOB_WORKER_URL=
STEAM_JOB_WORKER_SERVICE_ACCOUNT=
STEAM_JOB_BUCKET=
STEAM_JOB_COLLECTION=steam_jobs
STEAM_JOB_TTL_SECONDS=604800
STEAM_JOB_WORKER_TOKEN=
