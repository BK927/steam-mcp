{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plugin routing evaluation result",
  "type": "object",
  "required": ["run_id", "fixture_id", "expected_plugin", "selected_plugins", "tool_calls", "passed", "notes"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "fixture_id": { "type": "string", "minLength": 1 },
    "expected_plugin": { "type": ["string", "null"] },
    "selected_plugins": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plugin", "tool", "succeeded"],
        "properties": {
          "plugin": { "type": "string" },
          "tool": { "type": "string" },
          "succeeded": { "type": "boolean" },
          "error_code": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "passed": { "type": "boolean" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
